# =============================================================================
# ECHOWEB - Netlify Deployment Environment Variables
# =============================================================================
# Copy these into your Netlify Dashboard → Site → Environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
# Your PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/echoweb?schema=public"

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION (Required)
# -----------------------------------------------------------------------------
# Generate strong random secrets for production
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-this"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# CORS / FRONTEND URL (Required)
# -----------------------------------------------------------------------------
# Your Netlify site URL (e.g., https://your-site.netlify.app)
FRONTEND_URL="https://your-site.netlify.app"

# -----------------------------------------------------------------------------
# SERVER (Required for Netlify Functions)
# -----------------------------------------------------------------------------
NODE_ENV="production"

# -----------------------------------------------------------------------------
# OPTIONAL - Only if you use these features
# -----------------------------------------------------------------------------
# Email (SMTP)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="noreply@echoweb.com"

# Google Maps
# GOOGLE_MAPS_API_KEY=""

# AWS S3 (for file uploads)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""

# OpenAI
# OPENAI_API_KEY=""

# Redis
# REDIS_URL=""

# -----------------------------------------------------------------------------
# FRONTEND (Optional - only needed for local development)
# -----------------------------------------------------------------------------
# On Netlify, the frontend calls /api/* which auto-redirects to the function.
# Only set this for local development if backend runs on a different port.
# NEXT_PUBLIC_API_URL="http://localhost:5000"
