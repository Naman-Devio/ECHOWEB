  "repository": {
    "type": "git",
    "url": "https://github.com/Naman-Devio/ECHOWEB.git"
  },
  "bugs": {
    "url": "https://github.com/Naman-Devio/ECHOWEB/issues"
  },
  "homepage": "https://github.com/Naman-Devio/ECHOWEB#readme",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "npx prisma generate && npx prisma migrate deploy && tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "e-waste",
    "recycling",
    "sustainability",
    "environment",
    "express",
    "typescript",
    "prisma",
    "postgresql"
