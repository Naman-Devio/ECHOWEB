// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  INDIVIDUAL
  BUSINESS
  INSTITUTION
}

enum Language {
  EN
  HI
  TA
  TE
  BN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PickupStatus {
  PENDING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeviceType {
  MOBILE_PHONE
  LAPTOP
  DESKTOP
  TABLET
  MONITOR
  PRINTER
  KEYBOARD_MOUSE
  TV
  REFRIGERATOR
  WASHING_MACHINE
  AC
  BATTERY
  CHARGER
  CABLE
  SPEAKER
  CAMERA
  OTHER
}

model User {
  id                       String   @id @default(uuid())
  email                    String   @unique
  passwordHash             String
  name                     String
  phone                    String
  userType                 UserType @default(INDIVIDUAL)
  organizationName         String?
  gstNumber                String?
  language                 Language @default(EN)
  emailNotifications       Boolean  @default(true)
  smsNotifications         Boolean  @default(true)
  pushNotifications        Boolean  @default(true)
  emailVerified            Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  lastLoginAt              DateTime?

  pickupRequests           PickupRequest[]
  reviews                  Review[]
  impactMetrics            ImpactMetrics[]
  aiSessions               AISession[]

  @@index([email])
  @@index([userType])
}

model Recycler {
  id                       String             @id @default(uuid())
  businessName             String
  cpcbAuthNumber           String             @unique
  certificationExpiry      DateTime
  certificationDocuments   String[]
  verificationStatus       VerificationStatus @default(PENDING)
  verifiedAt               DateTime?
  verifiedBy               String?
  email                    String             @unique
  phone                    String
  website                  String?
  addressStreet            String
  addressCity              String
  addressState             String
  addressPincode           String
  latitude                 Float
  longitude                Float
  acceptedDeviceTypes      DeviceType[]
  bulkPickupAvailable      Boolean            @default(false)
  bulkMinimumKg            Float              @default(100)
  serviceRadius            Float              @default(10)
  operatingHours           Json
  averageRating            Float              @default(0)
  totalReviews             Int                @default(0)
  monthlyCapacityKg        Float
  currentMonthProcessedKg  Float              @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  pickupRequests           PickupRequest[]
  reviews                  Review[]

  @@index([verificationStatus])
  @@index([latitude, longitude])
  @@index([addressCity, addressState])
}

model PickupRequest {
  id                       String        @id @default(uuid())
  trackingId               String        @unique
  userId                   String
  recyclerId               String
  devices                  Json
  pickupAddressStreet      String
  pickupAddressCity        String
  pickupAddressState       String
  pickupAddressPincode     String
  pickupLatitude           Float
  pickupLongitude          Float
  pickupLandmark           String?
  contactPersonName        String
  contactPersonPhone       String
  preferredDate            DateTime
  preferredStartTime       String
  preferredEndTime         String
  status                   PickupStatus  @default(PENDING)
  statusHistory            Json
  actualWeightKg           Float?
  completedAt              DateTime?
  complianceCertificateUrl String?
  impactCO2SavedKg         Float?
  impactMaterialsRecovered Json?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user                     User          @relation(fields: [userId], references: [id])
  recycler                 Recycler      @relation(fields: [recyclerId], references: [id])
  review                   Review?

  @@index([trackingId])
  @@index([userId])
  @@index([recyclerId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id                       String        @id @default(uuid())
  recyclerId               String
  userId                   String
  pickupRequestId          String        @unique
  rating                   Int
  comment                  String?
  flagged                  Boolean       @default(false)
  flagReason               String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  recycler                 Recycler      @relation(fields: [recyclerId], references: [id])
  user                     User          @relation(fields: [userId], references: [id])
  pickupRequest            PickupRequest @relation(fields: [pickupRequestId], references: [id])

  @@index([recyclerId])
  @@index([userId])
  @@index([rating])
}

model ImpactMetrics {
  id                       String   @id @default(uuid())
  userId                   String?
  totalEWasteKg            Float    @default(0)
  totalCO2SavedKg          Float    @default(0)
  materialsRecovered       Json
  periodStart              DateTime
  periodEnd                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user                     User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([periodStart, periodEnd])
}

model AISession {
  id                       String   @id @default(uuid())
  userId                   String?
  messages                 Json
  identifiedDevices        Json
  language                 String   @default("en")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  expiresAt                DateTime

  user                     User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}
