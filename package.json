{
  "name": "echoweb",
  "version": "1.0.0",
  "description": "ECHOWEB - Sustainable E-Waste Management Platform (monorepo)",
  "private": true,
  "scripts": {
    "build": "npm install && npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm install && npx prisma generate && npx tsc",
    "build:frontend": "cd frontend && npm install && npm install @netlify/plugin-nextjs && npm run build",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "serverless-http": "^3.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {}
}
